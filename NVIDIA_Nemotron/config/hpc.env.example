# Copy to config/hpc.env and customize. This is trusted Bash code, sourced by
# the runner; quote values containing spaces. Paths below are project-relative.
# Keep the project, environment, and model cache on the shared HPC filesystem.
HPC_CONDA_MODULE="Anaconda3/2024.02-1"
HPC_PURGE_MODULES=1
HPC_ENV_PREFIX=".envs/nemotron-vllm"
HPC_MODEL_CACHE=".cache/huggingface/hub"
HPC_MODEL_ID="nvidia/Nemotron-Mini-4B-Instruct"
HPC_MODEL_REVISION="791833e92ebddb0bc2c1007f6d2b6764f886a2ae"
HPC_PARTITION="red"
HPC_GRES="gpu:a30:1"
HPC_MEMORY="32G"
HPC_TIME="04:00:00"
HPC_CPUS=4
HPC_JOB_NAME="nemotron-copilot"
HPC_LOG_DIR="logs"
# Optional site-specific SLURM accounting. Leave empty when not needed.
HPC_ACCOUNT=""
HPC_QOS=""
# Optional local model snapshot, bypassing public model download entirely:
# HPC_MODEL_PATH="/share/lab_goecks/models/nemotron-mini/snapshot"
# Optional shell module initializer if the site does not initialize modules:
# HPC_MODULE_INIT="/etc/profile.d/modules.sh"
# The runner purges CUDA/PyTorch modules before loading Anaconda by default.
# Native CUDA 12.8 GPU driver >=570.26 is checked by `doctor`; this script
# cannot install or upgrade the host GPU driver. The CUDA toolkit module is
# unnecessary for the prebuilt pip wheels.
